{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=myapp.db"
  },
  "Jwt": {
    "SecretKey": "CHANGE-THIS-TO-A-SECRET-KEY-OF-AT-LEAST-32-CHARS!",
    "Issuer": "MyApp",
    "Audience": "MyApp",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
